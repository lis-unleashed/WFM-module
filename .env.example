# Settings for local development. Local defaults are built in, so you only need
# a .env file to change them: copy this file to .env and edit it. Never commit
# .env, and never put real credentials in this file.
#
# Staging and production read the same WFM_* variables from their hosting
# platform or secrets manager, and have no defaults.

# local | test | staging | production
WFM_ENV=local

# --- Database
# The app's login. `make db` creates it as a member of the wfm_app role.
WFM_DATABASE_URL=postgresql://wfm_api:wfm_api@localhost:5432/wfm
# The schema owner, used by `wfm db migrate`.
WFM_MIGRATION_DATABASE_URL=postgresql://wfm_owner:wfm_owner@localhost:5432/wfm
# A superuser, for `wfm db setup` and `wfm db test`. Local and test only.
WFM_ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- Browser sessions
# Sites allowed to send changes to the API, comma-separated. https:// only
# outside local and test.
WFM_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# WFM_COOKIE_SECURE=false          # on everywhere except local
# WFM_SESSION_IDLE_MINUTES=360     # signed out after this long without a request
# WFM_SESSION_MAX_HOURS=12         # and after this long in total
# WFM_DEV_LOGIN_ENABLED=true       # email-only sign-in; local and test only

# --- Secrets for later steps
# Step 5: keys for encrypting Xero tokens, newest first. Make one with:
#   uv run wfm generate-key
# WFM_TOKEN_ENCRYPTION_KEYS=
# WFM_XERO_CLIENT_ID=
# WFM_XERO_CLIENT_SECRET=
# Step 6: Aircall API credentials
# WFM_AIRCALL_API_ID=
# WFM_AIRCALL_API_TOKEN=
